{
  "name": "food-randomizer",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preflight": "node scripts/check-node-version.mjs",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose down",
    "build:api": "npm run build --workspace apps/api",
    "test:api": "npm run test --workspace apps/api",
    "test:unit": "npm run test --workspace apps/api && npm run test --workspace apps/mobile",
    "test:integration": "npm run test:e2e:real --workspace apps/api",
    "test:e2e:critical": "npm run test:e2e --workspace apps/api",
    "test:contract:mobile-api": "node scripts/test-mobile-api-contract.mjs",
    "check:env": "bash scripts/check-env-files.sh",
    "test:headless": "bash scripts/run-tests-headless.sh",
    "test:background": "bash scripts/run-tests-background.sh",
    "test:headful:mobile": "bash scripts/run-mobile-headful.sh",
    "migrate:dev": "npm run prisma:migrate --workspace apps/api",
    "migrate:deploy": "npm run prisma:migrate:deploy --workspace apps/api",
    "prisma:generate": "npm run prisma:generate --workspace apps/api",
    "seed:api": "npm run prisma:seed --workspace apps/api",
    "assign-legacy-owner": "npm run prisma:assign-legacy-owner --workspace apps/api --",
    "deploy:api": "bash ./scripts/deploy-api.sh",
    "typecheck": "npm run build:api",
    "lint": "npm run lint --workspace apps/api",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
